# Firebase (get from Firebase Console → Project Settings → Your apps)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Cloudflare Worker URL (after deploying _worker.js with wrangler)
# During development: leave empty — the worker runs locally via wrangler pages dev
# In production: set to your deployed Pages URL, e.g. https://emonav.pages.dev
VITE_WORKER_URL=/api/ai
